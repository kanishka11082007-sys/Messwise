# Messwise Backend Environment Configuration
PROJECT_NAME="Messwise API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Default is SQLite for quick local development; set to PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/messwise
DATABASE_URL=sqlite+aiosqlite:///./messwise.db
SYNC_DATABASE_URL=sqlite:///./messwise.db

# JWT & Security
SECRET_KEY="messwise-dev-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Seed Data Auto-load
AUTO_SEED_DATA=true
