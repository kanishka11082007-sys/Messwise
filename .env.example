# ==============================================
# MessWise Full-Stack Environment Variables
# ==============================================

# Backend Configuration
ENVIRONMENT=production
PROJECT_NAME=MessWise
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-random-32-character-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default or PostgreSQL)
# PostgreSQL Example: postgresql+asyncpg://user:password@localhost:5432/messwise
DATABASE_URL=sqlite:///./messwise.db
AUTO_SEED_DATA=true

# Allowed CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:80"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
